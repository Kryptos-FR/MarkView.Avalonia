<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)../'))" />
  <ItemGroup>
    <!-- Harness -->
    <PackageVersion Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Svg.Skia (MarkView, Markdown.Avalonia) already needs these versions; every runner uses the same native Skia and HarfBuzz. -->
    <PackageVersion Include="HarfBuzzSharp" Version="14.2.0" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.0" />
    <!-- Competitors, each referenced by its own runner only -->
    <PackageVersion Include="LiveMarkdown.Avalonia" Version="2.4.3" />
    <PackageVersion Include="LiveMarkdown.Avalonia.Math" Version="2.4.3" />
    <PackageVersion Include="LiveMarkdown.Avalonia.Mermaid" Version="2.4.3" />
    <PackageVersion Include="Markdown.Avalonia" Version="12.0.2" />
    <PackageVersion Include="Markdown.Avalonia.Tight" Version="12.0.2" />
  </ItemGroup>
</Project>
