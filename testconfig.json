{
  "codeCoverage": {
    "Configuration": {
      "Format": "cobertura",
      "CodeCoverage": {
        "ModulePaths": {
          "Exclude": [".*\\.Tests\\.dll$"]
        },
        "Functions": {
          "Exclude": ["CompiledAvaloniaXaml", "^System\\.Text\\.RegularExpressions\\.Generated\\..*"]
        },
        "Attributes": {
          "Exclude": [
            "^System\\.Diagnostics\\.CodeAnalysis\\.ExcludeFromCodeCoverageAttribute$"
          ]
        }
      }
    }
  }
}
