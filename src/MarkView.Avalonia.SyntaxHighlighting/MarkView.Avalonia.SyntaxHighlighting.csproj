<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>MarkView.Avalonia.SyntaxHighlighting</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>MarkView.Avalonia.SyntaxHighlighting</PackageId>
    <Description>TextMate syntax highlighting extension for MarkView.Avalonia, the markdown viewer for Avalonia UI 12.</Description>
    <PackageTags>avalonia;avalonia12;markdown;syntax-highlighting;textmate</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TextMateSharp" />
    <PackageReference Include="TextMateSharp.Grammars" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MarkView.Avalonia\MarkView.Avalonia.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
