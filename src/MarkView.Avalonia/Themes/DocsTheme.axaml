<!-- Docs preset: the look of a documentation site, modelled on VitePress' default theme: Inter at 16px with
     airy line spacing, a column at most 768px wide, a divider above h2, code on a soft background and
     alerts as tinted boxes. Include it after MarkdownTheme.axaml, which it builds on: it redefines the
     resources where its look differs (colours, sizes, and the control themes of a few roles), and
     styles only the viewer, buttons, separators and links. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mv="using:MarkView.Avalonia"
        xmlns:mr="using:MarkView.Avalonia.Rendering"
        xmlns:mri="using:MarkView.Avalonia.Rendering.Inlines">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <!-- VitePress' dark colours. Translucent colours are written #AARRGGBB, Avalonia's order. -->
        <ResourceDictionary x:Key="Dark">
          <!-- The document's own background and text, set on MarkdownViewer -->
          <SolidColorBrush x:Key="MarkdownBackground">#1B1B1F</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownForeground">#DFDFD6</SolidColorBrush>
          <!-- Secondary text: blockquotes, h6, table headers, footnotes -->
          <SolidColorBrush x:Key="MarkdownMutedForeground">#98989F</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownLinkForeground">#A8B1FF</SolidColorBrush>
          <!-- VitePress' divider, for the decorative line above h2 and above the footnotes -->
          <SolidColorBrush x:Key="MarkdownHeadingBorder">#2E2E32</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownFootnoteSeparatorBackground">#2E2E32</SolidColorBrush>
          <!-- VitePress draws the quote bar, table grid and rule in its divider colour, below the 3:1
               WCAG AA minimum for borders that carry meaning; this grey meets it on the page and on the
               striped rows. -->
          <SolidColorBrush x:Key="MarkdownBlockquoteBorder">#75757C</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownTableBorder">#75757C</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownThematicBreakBackground">#75757C</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownTableHeaderBackground">#202127</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownTableRowAlternateBackground">#202127</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeBlockBackground">#161618</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeBlockForeground">#DFDFD6</SolidColorBrush>
          <!-- Inline code: the link colour on VitePress' translucent grey chip -->
          <SolidColorBrush x:Key="MarkdownCodeInlineBackground">#29657585</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeInlineForeground">#A8B1FF</SolidColorBrush>
          <!-- The toolbar shares the code's background, so the copy button sits in the block's corner -->
          <SolidColorBrush x:Key="MarkdownCodeHeaderBackground">#161618</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeHeaderForeground">#98989F</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeCopyButtonBorder">#2E2E32</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeCopyButtonHoverBackground">#202127</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeLineNumberForeground">#98989F</SolidColorBrush>
          <!-- Alerts: VitePress' tinted boxes, the title in the kind's colour -->
          <SolidColorBrush x:Key="MarkdownAlertDefaultBorder">#98989F</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertDefaultBackground">#29657585</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertNoteBorder">#A8B1FF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertNoteBackground">#29646CFF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertTipBorder">#3DD68C</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertTipBackground">#2910B981</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertImportantBorder">#C8ABFA</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertImportantBackground">#299F7AEA</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertWarningBorder">#F9B44E</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertWarningBackground">#29EAB308</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertCautionBorder">#F66F81</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertCautionBackground">#29F43F5E</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownMarkedBackground">#5C4B00</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownKbdBackground">#202127</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownKbdForeground">#DFDFD6</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownKbdBorder">#75757C</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownFindMatchBackground">#453A00</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownFindCurrentMatchBackground">#652A00</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageFailedForeground">#98989F</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageFailedBackground">#202127</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageFailedBorder">#75757C</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageLightboxBackdrop">#E0000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageLightboxCloseForeground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageLightboxCloseBackground">#66000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageLightboxCloseHoverBackground">#33FFFFFF</SolidColorBrush>
          <!-- High-contrast palette (MarkdownViewer:high-contrast): the default theme's -->
          <SolidColorBrush x:Key="MarkdownHighContrastBackground">#000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastForeground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastLink">#FFFF00</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastHighlightBackground">#1AEBFF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastHighlightForeground">#000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastBorder">#FFFFFF</SolidColorBrush>
        </ResourceDictionary>
        <!-- VitePress' light colours -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="MarkdownBackground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownForeground">#3C3C43</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownMutedForeground">#67676C</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownLinkForeground">#3451B2</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHeadingBorder">#E2E2E3</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownFootnoteSeparatorBackground">#E2E2E3</SolidColorBrush>
          <!-- VitePress' #E2E2E3 divider is below 3:1 on white; see the Dark dictionary -->
          <SolidColorBrush x:Key="MarkdownBlockquoteBorder">#87878C</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownTableBorder">#87878C</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownThematicBreakBackground">#87878C</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownTableHeaderBackground">#F6F6F7</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownTableRowAlternateBackground">#F6F6F7</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeBlockBackground">#F6F6F7</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeBlockForeground">#3C3C43</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeInlineBackground">#248E96AA</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeInlineForeground">#3451B2</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeHeaderBackground">#F6F6F7</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeHeaderForeground">#67676C</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeCopyButtonBorder">#E2E2E3</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeCopyButtonHoverBackground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeLineNumberForeground">#67676C</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertDefaultBorder">#67676C</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertDefaultBackground">#248E96AA</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertNoteBorder">#3451B2</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertNoteBackground">#24646CFF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertTipBorder">#18794E</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertTipBackground">#2410B981</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertImportantBorder">#6F42C1</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertImportantBackground">#249F7AEA</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertWarningBorder">#915930</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertWarningBackground">#24EAB308</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertCautionBorder">#B8272C</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertCautionBackground">#24F43F5E</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownMarkedBackground">#FFF3C4</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownKbdBackground">#F6F6F7</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownKbdForeground">#3C3C43</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownKbdBorder">#87878C</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownFindMatchBackground">#FFF176</SolidColorBrush>
          <!-- A paler orange than the default theme's, so inline code (link colour on its chip) keeps 4.5:1 -->
          <SolidColorBrush x:Key="MarkdownFindCurrentMatchBackground">#FFD3A3</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageFailedForeground">#67676C</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageFailedBackground">#F6F6F7</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageFailedBorder">#87878C</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageLightboxBackdrop">#CC000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageLightboxCloseForeground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageLightboxCloseBackground">#66000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageLightboxCloseHoverBackground">#33FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastBackground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastForeground">#000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastLink">#00009F</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastHighlightBackground">#37006E</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastHighlightForeground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastBorder">#000000</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <!-- Alerts have no bar; in high contrast they get an outline instead -->
      <Thickness x:Key="MarkdownAlertBorderThickness">0</Thickness>
      <Thickness x:Key="MarkdownHighContrastAlertBorderThickness">1</Thickness>

      <!-- Sizes and spacing (see MarkdownTheme.axaml) -->
      <!-- Code blocks: 24px side padding, 20px above and below, 8px corners, 14px monospace on 24px lines -->
      <FontFamily x:Key="MarkdownCodeFontFamily">SF Mono, Menlo, Monaco, Consolas, Liberation Mono, Courier New, monospace</FontFamily>
      <x:Double x:Key="MarkdownCodeFontSize">14</x:Double>
      <x:Double x:Key="MarkdownCodeLineHeight">24</x:Double>
      <CornerRadius x:Key="MarkdownCodeBlockCornerRadius">8</CornerRadius>
      <Thickness x:Key="MarkdownCodeBlockPadding">24,20</Thickness>
      <Thickness x:Key="MarkdownCodeBlockMargin">0,8</Thickness>
      <Thickness x:Key="MarkdownCodeContainerMargin">0,8</Thickness>
      <CornerRadius x:Key="MarkdownToolbarCodeBlockCornerRadius">0,0,8,8</CornerRadius>
      <Thickness x:Key="MarkdownToolbarCodeBlockPadding">24,4,24,20</Thickness>
      <CornerRadius x:Key="MarkdownCodeHeaderCornerRadius">8,8,0,0</CornerRadius>
      <Thickness x:Key="MarkdownCodeHeaderPadding">24,8,8,0</Thickness>
      <!-- The copy button is wider here; keep the formula clear of it -->
      <Thickness x:Key="MarkdownMathContentMargin">42,0</Thickness>
      <!-- Paragraphs: 16px apart, 28px lines; tight inside list items, table cells, quotes and alerts -->
      <Thickness x:Key="MarkdownParagraphMargin">0,4</Thickness>
      <x:Double x:Key="MarkdownParagraphLineSpacing">6</x:Double>
      <Thickness x:Key="MarkdownListParagraphMargin">0</Thickness>
      <Thickness x:Key="MarkdownTableParagraphMargin">0</Thickness>
      <x:Double x:Key="MarkdownTableParagraphLineSpacing">0</x:Double>
      <Thickness x:Key="MarkdownQuoteParagraphMargin">0</Thickness>
      <Thickness x:Key="MarkdownAlertParagraphMargin">0</Thickness>
      <x:Double x:Key="MarkdownAlertParagraphLineSpacing">4</x:Double>
      <!-- Lists: 20px indent, nested lists without extra space -->
      <Thickness x:Key="MarkdownListMargin">20,4,0,4</Thickness>
      <Thickness x:Key="MarkdownNestedListMargin">20,0,0,0</Thickness>
      <!-- Tables: a 1px grid on every side of every cell, a soft header and striped rows -->
      <Thickness x:Key="MarkdownTableCellPadding">16,8</Thickness>
      <Thickness x:Key="MarkdownTableFirstRowCellBorderThickness">0,1,1,1</Thickness>
      <Thickness x:Key="MarkdownTableFirstColumnCellBorderThickness">1,0,1,1</Thickness>
      <Thickness x:Key="MarkdownTableCornerCellBorderThickness">1</Thickness>
      <!-- Alerts: tinted boxes with 8px corners -->
      <CornerRadius x:Key="MarkdownAlertCornerRadius">8</CornerRadius>
      <Thickness x:Key="MarkdownAlertPadding">16,12</Thickness>
      <Thickness x:Key="MarkdownAlertMargin">0,8</Thickness>
      <x:Double x:Key="MarkdownAlertHeaderFontSize">14</x:Double>

      <!-- A reading column at most 768px wide, centred in a wider viewer (a stretched control narrower
           than its slot is centred in it) -->
      <ControlTheme x:Key="MarkdownDocumentTheme" TargetType="Grid">
        <Setter Property="MaxWidth" Value="768" />
      </ControlTheme>

      <!-- Headings: semibold, 32 / 24 / 20 / 18 / 16 / 16px, more space above than below, and no space
           above a heading that starts the document, a quote or an alert. h2 opens a section: a divider
           above it, 24px over the text, left out at the start. -->
      <ControlTheme x:Key="MarkdownHeading1Theme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="LineHeight" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,16,0,0" />
        <Style Selector="^:nth-child(1)">
          <Setter Property="Margin" Value="0" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="MarkdownHeading2Theme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="LineHeight" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,32,0,0" />
        <Setter Property="Padding" Value="0,24,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource MarkdownHeadingBorder}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Style Selector="^:nth-child(1)">
          <Setter Property="Margin" Value="0" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="BorderThickness" Value="0" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="MarkdownHeading3Theme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,24,0,0" />
        <Style Selector="^:nth-child(1)">
          <Setter Property="Margin" Value="0" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="MarkdownHeading4Theme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,16,0,0" />
        <Style Selector="^:nth-child(1)">
          <Setter Property="Margin" Value="0" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="MarkdownHeading5Theme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,16,0,0" />
        <Style Selector="^:nth-child(1)">
          <Setter Property="Margin" Value="0" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="MarkdownHeading6Theme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,16,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource MarkdownMutedForeground}" />
        <Style Selector="^:nth-child(1)">
          <Setter Property="Margin" Value="0" />
        </Style>
      </ControlTheme>

      <!-- Inline code: monospace in the link colour on a grey chip, at 14px in body text -->
      <ControlTheme x:Key="MarkdownParagraphCodeInlineTheme" TargetType="Run">
        <Setter Property="FontFamily" Value="{DynamicResource MarkdownCodeFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="{DynamicResource MarkdownCodeInlineBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource MarkdownCodeInlineForeground}" />
      </ControlTheme>

      <!-- Blockquote: a 2px bar and secondary text, no dimming -->
      <ControlTheme x:Key="MarkdownBlockquoteTheme" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource MarkdownBlockquoteBorder}" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MarkdownMutedForeground}" />
      </ControlTheme>

      <!-- Tables: 14px text, the header in semibold secondary text -->
      <ControlTheme x:Key="MarkdownTableTheme" TargetType="Grid">
        <Setter Property="Margin" Value="0,12" />
        <Setter Property="TextElement.FontSize" Value="14" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownTableHeaderContentTheme" TargetType="StackPanel">
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MarkdownMutedForeground}" />
      </ControlTheme>

      <!-- Alerts: 14px text, the title in the kind's colour -->
      <ControlTheme x:Key="MarkdownAlertContentTheme" TargetType="StackPanel">
        <Setter Property="TextElement.FontSize" Value="14" />
      </ControlTheme>

      <!-- Footnotes: in 14px secondary text, no dimming -->
      <ControlTheme x:Key="MarkdownFootnoteGroupTheme" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MarkdownMutedForeground}" />
        <Setter Property="TextElement.FontSize" Value="14" />
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Document: VitePress' background, text colour and Inter at 16px. Local values set on a
       MarkdownViewer (Background="Transparent", FontSize="14") still win. The Inter an application
       embeds (WithInterFont) comes first, since a plain "Inter" only names an installed one. -->
  <Style Selector=":is(mv|MarkdownViewer)">
    <Setter Property="Background" Value="{DynamicResource MarkdownBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource MarkdownForeground}" />
    <Setter Property="FontFamily" Value="fonts:Inter#Inter, Inter, Segoe UI, SF Pro Text, Helvetica Neue, Noto Sans, Helvetica, Arial" />
    <Setter Property="FontSize" Value="16" />
  </Style>

  <!-- Links: medium weight, underlined -->
  <Style Selector="mri|MarkdownHyperlink.markdown-link">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- Copy buttons: outlined, in the block's corner, the formula's lined up with a code block's -->
  <Style Selector="Button.markdown-code-copy">
    <Setter Property="BorderBrush" Value="{DynamicResource MarkdownCodeCopyButtonBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="7" />
  </Style>
  <Style Selector="Button.markdown-code-copy:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource MarkdownCodeCopyButtonBorder}" />
  </Style>
  <Style Selector="Button.markdown-code-copy.markdown-math-copy">
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>

  <!-- Horizontal rule: a 1px line -->
  <Style Selector="Separator.markdown-thematic-break">
    <Setter Property="Background" Value="{DynamicResource MarkdownThematicBreakBackground}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,8" />
  </Style>

  <!-- Footnotes: below a 1px line -->
  <Style Selector="Separator.markdown-footnote-separator">
    <Setter Property="Background" Value="{DynamicResource MarkdownFootnoteSeparatorBackground}" />
    <Setter Property="Margin" Value="0,24,0,0" />
  </Style>
</Styles>
