<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mv="using:MarkView.Avalonia"
        xmlns:mri="using:MarkView.Avalonia.Rendering.Inlines"
        xmlns:mrb="using:MarkView.Avalonia.Rendering.Blocks"
        xmlns:mr="using:MarkView.Avalonia.Rendering">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="MarkdownCodeBlockBackground">#1E1E1E</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeBlockForeground">#D4D4D4</SolidColorBrush>
          <!-- Inline code: a light chip on the dark page, and text light enough to keep 4.5:1 on the chip over
               a find match (4.7:1), where the chip lightens the highlight; 9.8:1 on the chip over black -->
          <SolidColorBrush x:Key="MarkdownCodeInlineBackground">#1AFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeInlineForeground">#F4B49A</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeHeaderBackground">#2D2D2D</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeHeaderForeground">#A0A0A0</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeCopyButtonHoverBackground">#1AFFFFFF</SolidColorBrush>
          <!-- Links: a lighter shade of the accent colour keeps 4.5:1 on dark backgrounds for any accent -->
          <SolidColorBrush x:Key="MarkdownLinkForeground" Color="{DynamicResource SystemAccentColorLight2}" />
          <SolidColorBrush x:Key="MarkdownBlockquoteBorder">#4A9ECC</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownTableBorder">#6B6B6B</SolidColorBrush>
          <!-- 4.8:1 contrast on MarkdownCodeBlockBackground -->
          <SolidColorBrush x:Key="MarkdownCodeLineNumberForeground">#8A8A8A</SolidColorBrush>
          <!-- Alert accent colours — dark theme (Default: kinds without their own colours, e.g. [!QUESTION]) -->
          <SolidColorBrush x:Key="MarkdownAlertDefaultBorder">#A1A1AA</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertDefaultBackground">#1A71717A</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertNoteBorder">#3B82F6</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertNoteBackground">#1A3B82F6</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertTipBorder">#22C55E</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertTipBackground">#1A22C55E</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertImportantBorder">#A855F7</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertImportantBackground">#1AA855F7</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertWarningBorder">#EAB308</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertWarningBackground">#1AEAB308</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertCautionBorder">#EF4444</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertCautionBackground">#1AEF4444</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownMarkedBackground">#5C4B00</SolidColorBrush>
          <!-- HTML <kbd>: text 15.9:1 on the key; border 3.8:1 on the key, 4.6:1 on black -->
          <SolidColorBrush x:Key="MarkdownKbdBackground">#151B23</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownKbdForeground">#F0F6FC</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownKbdBorder">#6E7681</SolidColorBrush>
          <!-- Find matches: text keeps its own colour on them; at least 4.5:1 for the body text, code blocks
               (MarkdownCodeBlockForeground) and inline code (MarkdownCodeInlineForeground) -->
          <SolidColorBrush x:Key="MarkdownFindMatchBackground">#453A00</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownFindCurrentMatchBackground">#652A00</SolidColorBrush>
          <!-- Image that could not be loaded: 8.2:1 text on the page, 5.8:1 on its background; border 3.5:1 -->
          <SolidColorBrush x:Key="MarkdownImageFailedForeground">#A1A1AA</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageFailedBackground">#27272A</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageFailedBorder">#7A7A83</SolidColorBrush>
          <!-- Image lightbox: the close cross is 12:1 or more on the backdrop over any page -->
          <SolidColorBrush x:Key="MarkdownImageLightboxBackdrop">#E0000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageLightboxCloseForeground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageLightboxCloseBackground">#66000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageLightboxCloseHoverBackground">#33FFFFFF</SolidColorBrush>
          <!-- High-contrast colours (MarkdownViewer:high-contrast, see MarkdownHighContrastPalette below),
               modelled on Windows' dark contrast themes. Avalonia exposes no system contrast colours, so
               these stand in for them. -->
          <SolidColorBrush x:Key="MarkdownHighContrastBackground">#000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastForeground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastLink">#FFFF00</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastHighlightBackground">#1AEBFF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastHighlightForeground">#000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastBorder">#FFFFFF</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="MarkdownCodeBlockBackground">#F3F3F3</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeBlockForeground">#1E1E1E</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeInlineBackground">#0A000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeInlineForeground">#A31515</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeHeaderBackground">#E4E4E4</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeHeaderForeground">#5F5F5F</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeCopyButtonHoverBackground">#14000000</SolidColorBrush>
          <!-- Links: a darker shade of the accent colour, as WinUI does, keeps 4.5:1 on light backgrounds -->
          <SolidColorBrush x:Key="MarkdownLinkForeground" Color="{DynamicResource SystemAccentColorDark2}" />
          <SolidColorBrush x:Key="MarkdownBlockquoteBorder">#2F7FB3</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownTableBorder">#8A8A8A</SolidColorBrush>
          <!-- 4.9:1 contrast on MarkdownCodeBlockBackground -->
          <SolidColorBrush x:Key="MarkdownCodeLineNumberForeground">#6A6A6A</SolidColorBrush>
          <!-- Alert accent colours — light theme (Default: kinds without their own colours, e.g. [!QUESTION]) -->
          <SolidColorBrush x:Key="MarkdownAlertDefaultBorder">#52525B</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertDefaultBackground">#F4F4F5</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertNoteBorder">#2563EB</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertNoteBackground">#EFF6FF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertTipBorder">#15803D</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertTipBackground">#F0FDF4</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertImportantBorder">#9333EA</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertImportantBackground">#FAF5FF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertWarningBorder">#A16207</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertWarningBackground">#FEFCE8</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertCautionBorder">#B91C1C</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertCautionBackground">#FEF2F2</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownMarkedBackground">#FFFF00</SolidColorBrush>
          <!-- HTML <kbd>: text 14.8:1 on the key; border 3.2:1 on the key, 3.5:1 on white -->
          <SolidColorBrush x:Key="MarkdownKbdBackground">#F6F8FA</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownKbdForeground">#1F2328</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownKbdBorder">#818B98</SolidColorBrush>
          <!-- Find matches: text keeps its own colour on them; at least 4.5:1 for the body text, code blocks
               (MarkdownCodeBlockForeground) and inline code (MarkdownCodeInlineForeground) -->
          <SolidColorBrush x:Key="MarkdownFindMatchBackground">#FFF176</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownFindCurrentMatchBackground">#FFC584</SolidColorBrush>
          <!-- Image that could not be loaded: 7.7:1 text on the page, 7.0:1 on its background; border 3.5:1 -->
          <SolidColorBrush x:Key="MarkdownImageFailedForeground">#52525B</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageFailedBackground">#F4F4F5</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageFailedBorder">#82828B</SolidColorBrush>
          <!-- Image lightbox: the close cross is 12:1 or more on the backdrop over any page -->
          <SolidColorBrush x:Key="MarkdownImageLightboxBackdrop">#CC000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageLightboxCloseForeground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageLightboxCloseBackground">#66000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageLightboxCloseHoverBackground">#33FFFFFF</SolidColorBrush>
          <!-- High-contrast palette, modelled on Windows' light contrast themes -->
          <SolidColorBrush x:Key="MarkdownHighContrastBackground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastForeground">#000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastLink">#00009F</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastHighlightBackground">#37006E</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastHighlightForeground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastBorder">#000000</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <!-- Colours that don't change with the theme variant -->
      <SolidColorBrush x:Key="MarkdownCodeBlockBorder">Transparent</SolidColorBrush>
      <SolidColorBrush x:Key="MarkdownTableHeaderBackground">#20808080</SolidColorBrush>
      <SolidColorBrush x:Key="MarkdownFigureBorder">#40808080</SolidColorBrush>
      <SolidColorBrush x:Key="MarkdownThinkingBorder">#40808080</SolidColorBrush>
      <!-- Borders and dimming that high contrast changes -->
      <Thickness x:Key="MarkdownCodeBlockBorderThickness">0</Thickness>
      <Thickness x:Key="MarkdownCodeHeaderBorderThickness">0</Thickness>
      <x:Double x:Key="MarkdownBlockquoteOpacity">0.85</x:Double>
      <x:Double x:Key="MarkdownFootnoteOpacity">0.85</x:Double>
      <x:Double x:Key="MarkdownFigureCaptionOpacity">0.75</x:Double>
      <!-- Discreet beside the heading; still 3:1 or more on the page for the default and GitHub headings -->
      <x:Double x:Key="MarkdownHeadingFoldOpacity">0.7</x:Double>
      <x:Double x:Key="MarkdownThinkingHeaderOpacity">0.75</x:Double>
      <x:Double x:Key="MarkdownThinkingContentOpacity">0.8</x:Double>
      <!-- High contrast. MarkdownViewer gets :high-contrast when the OS asks for it (see HighContrastMode),
           and then adds these values to its own resources, over the ones above and a preset's: solid colours
           from the MarkdownHighContrast* keys, solid borders where colour alone told blocks apart, and no
           dimming. A string names the key the value comes from, looked up from the viewer, so a preset only
           redefines the MarkdownHighContrast* keys; an entry whose key no theme defines is left out. Swapping
           values instead of adding :high-contrast styles costs nothing per control while high contrast is off. -->
      <ResourceDictionary x:Key="MarkdownHighContrastPalette">
        <!-- The page, set on MarkdownViewer by the GitHub and Docs presets -->
        <x:String x:Key="MarkdownBackground">MarkdownHighContrastBackground</x:String>
        <x:String x:Key="MarkdownForeground">MarkdownHighContrastForeground</x:String>
        <x:String x:Key="MarkdownMutedForeground">MarkdownHighContrastForeground</x:String>
        <x:String x:Key="MarkdownLinkForeground">MarkdownHighContrastLink</x:String>
        <x:String x:Key="MarkdownHeadingBorder">MarkdownHighContrastBorder</x:String>
        <x:Double x:Key="MarkdownHeadingFoldOpacity">1</x:Double>
        <!-- Code blocks, their toolbar and inline code -->
        <x:String x:Key="MarkdownCodeBlockBackground">MarkdownHighContrastBackground</x:String>
        <x:String x:Key="MarkdownCodeBlockForeground">MarkdownHighContrastForeground</x:String>
        <x:String x:Key="MarkdownCodeBlockBorder">MarkdownHighContrastBorder</x:String>
        <Thickness x:Key="MarkdownCodeBlockBorderThickness">1</Thickness>
        <x:String x:Key="MarkdownToolbarCodeBlockBorderThickness">MarkdownHighContrastToolbarCodeBlockBorderThickness</x:String>
        <x:String x:Key="MarkdownCodeLineNumberForeground">MarkdownHighContrastForeground</x:String>
        <x:String x:Key="MarkdownCodeHeaderBackground">MarkdownHighContrastBackground</x:String>
        <x:String x:Key="MarkdownCodeHeaderForeground">MarkdownHighContrastForeground</x:String>
        <Thickness x:Key="MarkdownCodeHeaderBorderThickness">1,1,1,0</Thickness>
        <x:String x:Key="MarkdownCodeCopyButtonBorder">MarkdownHighContrastBorder</x:String>
        <SolidColorBrush x:Key="MarkdownCodeInlineBackground">Transparent</SolidColorBrush>
        <x:String x:Key="MarkdownCodeInlineForeground">MarkdownHighContrastForeground</x:String>
        <!-- Marked text (its text colour is set by MarkdownMarkedTheme below) -->
        <x:String x:Key="MarkdownMarkedBackground">MarkdownHighContrastHighlightBackground</x:String>
        <!-- Quotes, tables, rules, footnotes and figures -->
        <x:String x:Key="MarkdownBlockquoteBorder">MarkdownHighContrastBorder</x:String>
        <x:Double x:Key="MarkdownBlockquoteOpacity">1</x:Double>
        <x:String x:Key="MarkdownTableBorder">MarkdownHighContrastBorder</x:String>
        <SolidColorBrush x:Key="MarkdownTableHeaderBackground">Transparent</SolidColorBrush>
        <SolidColorBrush x:Key="MarkdownTableRowAlternateBackground">Transparent</SolidColorBrush>
        <x:String x:Key="MarkdownThematicBreakBackground">MarkdownHighContrastBorder</x:String>
        <x:String x:Key="MarkdownFootnoteSeparatorBackground">MarkdownHighContrastBorder</x:String>
        <x:Double x:Key="MarkdownFootnoteOpacity">1</x:Double>
        <x:String x:Key="MarkdownFigureBorder">MarkdownHighContrastBorder</x:String>
        <x:Double x:Key="MarkdownFigureCaptionOpacity">1</x:Double>
        <!-- An image that could not be loaded: its alt text and glyph on the page colours, in a solid outline -->
        <x:String x:Key="MarkdownImageFailedBackground">MarkdownHighContrastBackground</x:String>
        <x:String x:Key="MarkdownImageFailedBorder">MarkdownHighContrastBorder</x:String>
        <x:String x:Key="MarkdownImageFailedForeground">MarkdownHighContrastForeground</x:String>
        <!-- Alerts keep their title text and left bar, but lose the per-kind colours: in a contrast theme
             every alert uses the same border colour (and title colour, set by MarkdownAlertHeaderTheme below) -->
        <x:String x:Key="MarkdownAlertDefaultBorder">MarkdownHighContrastBorder</x:String>
        <x:String x:Key="MarkdownAlertDefaultBackground">MarkdownHighContrastBackground</x:String>
        <x:String x:Key="MarkdownAlertNoteBorder">MarkdownHighContrastBorder</x:String>
        <x:String x:Key="MarkdownAlertNoteBackground">MarkdownHighContrastBackground</x:String>
        <x:String x:Key="MarkdownAlertTipBorder">MarkdownHighContrastBorder</x:String>
        <x:String x:Key="MarkdownAlertTipBackground">MarkdownHighContrastBackground</x:String>
        <x:String x:Key="MarkdownAlertImportantBorder">MarkdownHighContrastBorder</x:String>
        <x:String x:Key="MarkdownAlertImportantBackground">MarkdownHighContrastBackground</x:String>
        <x:String x:Key="MarkdownAlertWarningBorder">MarkdownHighContrastBorder</x:String>
        <x:String x:Key="MarkdownAlertWarningBackground">MarkdownHighContrastBackground</x:String>
        <x:String x:Key="MarkdownAlertCautionBorder">MarkdownHighContrastBorder</x:String>
        <x:String x:Key="MarkdownAlertCautionBackground">MarkdownHighContrastBackground</x:String>
        <!-- The Docs preset outlines its alerts, which have no bar -->
        <x:String x:Key="MarkdownAlertBorderThickness">MarkdownHighContrastAlertBorderThickness</x:String>
        <!-- Thinking blocks -->
        <x:Double x:Key="MarkdownThinkingHeaderOpacity">1</x:Double>
        <x:String x:Key="MarkdownThinkingBorder">MarkdownHighContrastBorder</x:String>
        <x:Double x:Key="MarkdownThinkingContentOpacity">1</x:Double>
      </ResourceDictionary>
      <!-- Sizes and spacing of the document's elements, read by the control themes below: a preset
           changes the look by redefining these keys -->
      <FontFamily x:Key="MarkdownCodeFontFamily">Cascadia Code, Consolas, Courier New, monospace</FontFamily>
      <x:Double x:Key="MarkdownCodeFontSize">13</x:Double>
      <x:Double x:Key="MarkdownCodeLineHeight">NaN</x:Double>
      <CornerRadius x:Key="MarkdownCodeBlockCornerRadius">4</CornerRadius>
      <Thickness x:Key="MarkdownCodeBlockPadding">12,8</Thickness>
      <Thickness x:Key="MarkdownCodeBlockMargin">0,4</Thickness>
      <!-- A code block under its toolbar (language label and copy button), which takes the top corners -->
      <CornerRadius x:Key="MarkdownToolbarCodeBlockCornerRadius">0,0,4,4</CornerRadius>
      <Thickness x:Key="MarkdownToolbarCodeBlockPadding">12,8</Thickness>
      <Thickness x:Key="MarkdownToolbarCodeBlockBorderThickness">0</Thickness>
      <Thickness x:Key="MarkdownHighContrastToolbarCodeBlockBorderThickness">1</Thickness>
      <CornerRadius x:Key="MarkdownCodeHeaderCornerRadius">4,4,0,0</CornerRadius>
      <Thickness x:Key="MarkdownCodeHeaderPadding">12,2,4,2</Thickness>
      <Thickness x:Key="MarkdownCodeContainerMargin">0,4</Thickness>
      <Thickness x:Key="MarkdownCustomFenceMargin">0,4</Thickness>
      <!-- Room for a display formula's copy button on both sides, so the formula stays centred and
           never runs under it -->
      <Thickness x:Key="MarkdownMathContentMargin">32,0</Thickness>
      <!-- Paragraphs, and paragraphs in a list item, a table cell, a quote or an alert -->
      <Thickness x:Key="MarkdownParagraphMargin">0,2</Thickness>
      <x:Double x:Key="MarkdownParagraphLineSpacing">0</x:Double>
      <Thickness x:Key="MarkdownListParagraphMargin">0,2</Thickness>
      <Thickness x:Key="MarkdownTableParagraphMargin">0,2</Thickness>
      <x:Double x:Key="MarkdownTableParagraphLineSpacing">0</x:Double>
      <Thickness x:Key="MarkdownQuoteParagraphMargin">0,2</Thickness>
      <Thickness x:Key="MarkdownAlertParagraphMargin">0,2</Thickness>
      <x:Double x:Key="MarkdownAlertParagraphLineSpacing">0</x:Double>
      <Thickness x:Key="MarkdownListMargin">16,4,0,4</Thickness>
      <Thickness x:Key="MarkdownNestedListMargin">16,4,0,4</Thickness>
      <!-- Tables: cells draw their right and bottom borders; those of the first row and column can add
           the top and left ones -->
      <Thickness x:Key="MarkdownTableMargin">0,4</Thickness>
      <Thickness x:Key="MarkdownTableCellPadding">8,4</Thickness>
      <Thickness x:Key="MarkdownTableCellBorderThickness">0,0,1,1</Thickness>
      <Thickness x:Key="MarkdownTableFirstRowCellBorderThickness">0,0,1,1</Thickness>
      <Thickness x:Key="MarkdownTableFirstColumnCellBorderThickness">0,0,1,1</Thickness>
      <Thickness x:Key="MarkdownTableCornerCellBorderThickness">0,0,1,1</Thickness>
      <FontWeight x:Key="MarkdownTableHeaderFontWeight">Bold</FontWeight>
      <Thickness x:Key="MarkdownAlertBorderThickness">4,0,0,0</Thickness>
      <CornerRadius x:Key="MarkdownAlertCornerRadius">0,4,4,0</CornerRadius>
      <Thickness x:Key="MarkdownAlertPadding">12,8</Thickness>
      <Thickness x:Key="MarkdownAlertMargin">0,4</Thickness>
      <FontWeight x:Key="MarkdownAlertHeaderFontWeight">SemiBold</FontWeight>
      <x:Double x:Key="MarkdownAlertHeaderFontSize">13</x:Double>
      <Thickness x:Key="MarkdownAlertHeaderMargin">0,0,0,4</Thickness>
      <Thickness x:Key="MarkdownDetailsMargin">0,4</Thickness>
      <Thickness x:Key="MarkdownDefinitionMargin">24,0,0,0</Thickness>
      <CornerRadius x:Key="MarkdownCustomContainerCornerRadius">4</CornerRadius>
      <Thickness x:Key="MarkdownCustomContainerMargin">0,4</Thickness>

      <!-- Control themes. The renderers give each of the document's controls the theme of its role
           (AvaloniaRenderer.ApplyTheme), found by key from the viewer, so a theme, unlike a style, only
           costs memory on the controls it is set on. The markdown-* classes stay on the controls for the
           application's own styles, which win over these themes. A preset redefines the keys above, or a
           whole theme where its look needs more (for example an inherited text colour). -->

      <!-- Headings -->
      <ControlTheme x:Key="MarkdownHeading1Theme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,8,0,4" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownHeading2Theme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,8,0,4" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownHeading3Theme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,6,0,2" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownHeading4Theme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,4,0,2" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownHeading5Theme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,4,0,2" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownHeading6Theme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,4,0,2" />
      </ControlTheme>

      <!-- Paragraphs; in a list item, a table cell, a quote or an alert, the innermost of an alert, a
           table, a quote and a list, in that order -->
      <ControlTheme x:Key="MarkdownParagraphTheme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="Margin" Value="{DynamicResource MarkdownParagraphMargin}" />
        <Setter Property="LineSpacing" Value="{DynamicResource MarkdownParagraphLineSpacing}" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownListParagraphTheme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="Margin" Value="{DynamicResource MarkdownListParagraphMargin}" />
        <Setter Property="LineSpacing" Value="{DynamicResource MarkdownParagraphLineSpacing}" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownTableParagraphTheme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="Margin" Value="{DynamicResource MarkdownTableParagraphMargin}" />
        <Setter Property="LineSpacing" Value="{DynamicResource MarkdownTableParagraphLineSpacing}" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownQuoteParagraphTheme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="Margin" Value="{DynamicResource MarkdownQuoteParagraphMargin}" />
        <Setter Property="LineSpacing" Value="{DynamicResource MarkdownParagraphLineSpacing}" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownAlertParagraphTheme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="Margin" Value="{DynamicResource MarkdownAlertParagraphMargin}" />
        <Setter Property="LineSpacing" Value="{DynamicResource MarkdownAlertParagraphLineSpacing}" />
      </ControlTheme>

      <!-- Code blocks -->
      <ControlTheme x:Key="MarkdownCodeBlockTheme" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MarkdownCodeBlockBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MarkdownCodeBlockBorder}" />
        <Setter Property="BorderThickness" Value="{DynamicResource MarkdownCodeBlockBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource MarkdownCodeBlockCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource MarkdownCodeBlockPadding}" />
        <Setter Property="Margin" Value="{DynamicResource MarkdownCodeBlockMargin}" />
      </ControlTheme>
      <!-- Under the toolbar; the container around both keeps the block's place in the document -->
      <ControlTheme x:Key="MarkdownToolbarCodeBlockTheme" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MarkdownCodeBlockBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MarkdownCodeBlockBorder}" />
        <Setter Property="BorderThickness" Value="{DynamicResource MarkdownToolbarCodeBlockBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource MarkdownToolbarCodeBlockCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource MarkdownToolbarCodeBlockPadding}" />
      </ControlTheme>
      <!-- The code, and the line numbers beside it, which share its font (and so its line height) -->
      <ControlTheme x:Key="MarkdownCodeTheme" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MarkdownCodeFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource MarkdownCodeFontSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource MarkdownCodeLineHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource MarkdownCodeBlockForeground}" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownCodeLineNumbersTheme" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MarkdownCodeFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource MarkdownCodeFontSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource MarkdownCodeLineHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource MarkdownCodeLineNumberForeground}" />
        <Setter Property="Margin" Value="0,0,16,0" />
      </ControlTheme>
      <!-- Fenced code blocks rendered as an application's own control (FenceRendererExtension) -->
      <ControlTheme x:Key="MarkdownCustomFenceTheme" TargetType="Border">
        <Setter Property="Margin" Value="{DynamicResource MarkdownCustomFenceMargin}" />
      </ControlTheme>
      <!-- Code block toolbar (language label and copy button above the code) -->
      <ControlTheme x:Key="MarkdownCodeContainerTheme" TargetType="StackPanel">
        <Setter Property="Margin" Value="{DynamicResource MarkdownCodeContainerMargin}" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownCodeHeaderTheme" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MarkdownCodeHeaderBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MarkdownCodeBlockBorder}" />
        <Setter Property="BorderThickness" Value="{DynamicResource MarkdownCodeHeaderBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource MarkdownCodeHeaderCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource MarkdownCodeHeaderPadding}" />
        <Setter Property="MinHeight" Value="28" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownCodeLanguageTheme" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MarkdownCodeHeaderForeground}" />
      </ControlTheme>
      <!-- A display formula next to its copy button (MarkView.Avalonia.Math) -->
      <ControlTheme x:Key="MarkdownMathContentTheme" TargetType="Border">
        <Setter Property="Margin" Value="{DynamicResource MarkdownMathContentMargin}" />
      </ControlTheme>

      <!-- Inline code, in a paragraph and elsewhere (a heading, a title); a preset can size it to the
           paragraph's text by redefining MarkdownParagraphCodeInlineTheme -->
      <ControlTheme x:Key="MarkdownCodeInlineTheme" TargetType="Run">
        <Setter Property="FontFamily" Value="{DynamicResource MarkdownCodeFontFamily}" />
        <Setter Property="Background" Value="{DynamicResource MarkdownCodeInlineBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource MarkdownCodeInlineForeground}" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownParagraphCodeInlineTheme" TargetType="Run">
        <Setter Property="FontFamily" Value="{DynamicResource MarkdownCodeFontFamily}" />
        <Setter Property="Background" Value="{DynamicResource MarkdownCodeInlineBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource MarkdownCodeInlineForeground}" />
      </ControlTheme>

      <!-- Marked / highlighted text -->
      <ControlTheme x:Key="MarkdownMarkedTheme" TargetType="Span">
        <Setter Property="Background" Value="{DynamicResource MarkdownMarkedBackground}" />
        <Style Selector="^[(mv|MarkdownViewer.InHighContrast)=True]">
          <Setter Property="Foreground" Value="{DynamicResource MarkdownHighContrastHighlightForeground}" />
        </Style>
      </ControlTheme>
      <!-- Citation -->
      <ControlTheme x:Key="MarkdownCitationTheme" TargetType="Span">
        <Setter Property="FontStyle" Value="Italic" />
      </ControlTheme>
      <!-- HTML subset (UseHtmlSubset): <kbd> as a key -->
      <ControlTheme x:Key="MarkdownKbdTheme" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MarkdownKbdBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MarkdownKbdBorder}" />
        <Setter Property="BorderThickness" Value="1,1,1,2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Margin" Value="1,0" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownKbdTextTheme" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New, monospace" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MarkdownKbdForeground}" />
      </ControlTheme>
      <!-- Abbreviations -->
      <ControlTheme x:Key="MarkdownAbbreviationTheme" TargetType="TextBlock">
        <Setter Property="TextDecorations" Value="Underline" />
        <Setter Property="Cursor" Value="Help" />
      </ControlTheme>

      <!-- Blockquote -->
      <ControlTheme x:Key="MarkdownBlockquoteTheme" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource MarkdownBlockquoteBorder}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Opacity" Value="{DynamicResource MarkdownBlockquoteOpacity}" />
      </ControlTheme>

      <!-- Lists, and lists inside a list item -->
      <ControlTheme x:Key="MarkdownListTheme" TargetType="StackPanel">
        <Setter Property="Margin" Value="{DynamicResource MarkdownListMargin}" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownNestedListTheme" TargetType="StackPanel">
        <Setter Property="Margin" Value="{DynamicResource MarkdownNestedListMargin}" />
      </ControlTheme>
      <!-- Task list markers: a symbol font, so ☐/☑ are not drawn as emoji -->
      <ControlTheme x:Key="MarkdownTaskMarkerTheme" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Symbol, Noto Sans Symbols, DejaVu Sans, sans-serif" />
      </ControlTheme>

      <!-- Placeholder of an image that could not be loaded: a broken-image glyph and the alt text. What
           it is, for screen readers, is set here so it can be translated. -->
      <ControlTheme x:Key="MarkdownImageFailedTheme" TargetType="Border">
        <Setter Property="AutomationProperties.HelpText" Value="Image could not be loaded" />
        <Setter Property="Background" Value="{DynamicResource MarkdownImageFailedBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MarkdownImageFailedBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MarkdownImageFailedForeground}" />
      </ControlTheme>
      <!-- Lightbox a clicked image opens in (MarkdownViewer.IsImageZoomEnabled): the picture's backing and
           the zoom toolbar at the bottom, in the close button's colours -->
      <ControlTheme x:Key="MarkdownImageLightboxBackingTheme" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownImageLightboxToolbarTheme" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MarkdownImageLightboxCloseBackground}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="8" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownImageLightboxZoomLevelTheme" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MarkdownImageLightboxCloseForeground}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinWidth" Value="40" />
      </ControlTheme>

      <!-- Tables: the grid, its cells by position (the first row and column can draw the outer
           borders), and the content of header cells -->
      <ControlTheme x:Key="MarkdownTableTheme" TargetType="Grid">
        <Setter Property="Margin" Value="{DynamicResource MarkdownTableMargin}" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownTableCellTheme" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource MarkdownTableBorder}" />
        <Setter Property="BorderThickness" Value="{DynamicResource MarkdownTableCellBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource MarkdownTableCellPadding}" />
        <Style Selector="^.markdown-table-header">
          <Setter Property="Background" Value="{DynamicResource MarkdownTableHeaderBackground}" />
        </Style>
        <Style Selector="^.markdown-table-row-even">
          <Setter Property="Background" Value="{DynamicResource MarkdownTableRowAlternateBackground}" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="MarkdownTableFirstRowCellTheme" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource MarkdownTableBorder}" />
        <Setter Property="BorderThickness" Value="{DynamicResource MarkdownTableFirstRowCellBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource MarkdownTableCellPadding}" />
        <Style Selector="^.markdown-table-header">
          <Setter Property="Background" Value="{DynamicResource MarkdownTableHeaderBackground}" />
        </Style>
        <Style Selector="^.markdown-table-row-even">
          <Setter Property="Background" Value="{DynamicResource MarkdownTableRowAlternateBackground}" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="MarkdownTableFirstColumnCellTheme" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource MarkdownTableBorder}" />
        <Setter Property="BorderThickness" Value="{DynamicResource MarkdownTableFirstColumnCellBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource MarkdownTableCellPadding}" />
        <Style Selector="^.markdown-table-header">
          <Setter Property="Background" Value="{DynamicResource MarkdownTableHeaderBackground}" />
        </Style>
        <Style Selector="^.markdown-table-row-even">
          <Setter Property="Background" Value="{DynamicResource MarkdownTableRowAlternateBackground}" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="MarkdownTableCornerCellTheme" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource MarkdownTableBorder}" />
        <Setter Property="BorderThickness" Value="{DynamicResource MarkdownTableCornerCellBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource MarkdownTableCellPadding}" />
        <Style Selector="^.markdown-table-header">
          <Setter Property="Background" Value="{DynamicResource MarkdownTableHeaderBackground}" />
        </Style>
        <Style Selector="^.markdown-table-row-even">
          <Setter Property="Background" Value="{DynamicResource MarkdownTableRowAlternateBackground}" />
        </Style>
      </ControlTheme>
      <!-- A header cell's content; a column's own alignment (colons in the delimiter row) is set on it
           directly, so it wins over the theme's -->
      <ControlTheme x:Key="MarkdownTableHeaderContentTheme" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="{DynamicResource MarkdownTableHeaderAlignment}" />
        <Setter Property="TextElement.FontWeight" Value="{DynamicResource MarkdownTableHeaderFontWeight}" />
      </ControlTheme>

      <!-- Footnotes -->
      <ControlTheme x:Key="MarkdownFootnoteGroupTheme" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Opacity" Value="{DynamicResource MarkdownFootnoteOpacity}" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownFootnoteItemTheme" TargetType="Grid">
        <Setter Property="Margin" Value="0,2" />
      </ControlTheme>

      <!-- Alert blocks: the layout, and the colours of each kind (MarkdownAlertTheme for kinds without
           colours of their own, such as [!QUESTION]) -->
      <ControlTheme x:Key="MarkdownAlertTheme" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource MarkdownAlertDefaultBorder}" />
        <Setter Property="Background" Value="{DynamicResource MarkdownAlertDefaultBackground}" />
        <Setter Property="BorderThickness" Value="{DynamicResource MarkdownAlertBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource MarkdownAlertCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource MarkdownAlertPadding}" />
        <Setter Property="Margin" Value="{DynamicResource MarkdownAlertMargin}" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownAlertNoteTheme" TargetType="Border" BasedOn="{StaticResource MarkdownAlertTheme}">
        <Setter Property="BorderBrush" Value="{DynamicResource MarkdownAlertNoteBorder}" />
        <Setter Property="Background" Value="{DynamicResource MarkdownAlertNoteBackground}" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownAlertTipTheme" TargetType="Border" BasedOn="{StaticResource MarkdownAlertTheme}">
        <Setter Property="BorderBrush" Value="{DynamicResource MarkdownAlertTipBorder}" />
        <Setter Property="Background" Value="{DynamicResource MarkdownAlertTipBackground}" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownAlertImportantTheme" TargetType="Border" BasedOn="{StaticResource MarkdownAlertTheme}">
        <Setter Property="BorderBrush" Value="{DynamicResource MarkdownAlertImportantBorder}" />
        <Setter Property="Background" Value="{DynamicResource MarkdownAlertImportantBackground}" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownAlertWarningTheme" TargetType="Border" BasedOn="{StaticResource MarkdownAlertTheme}">
        <Setter Property="BorderBrush" Value="{DynamicResource MarkdownAlertWarningBorder}" />
        <Setter Property="Background" Value="{DynamicResource MarkdownAlertWarningBackground}" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownAlertCautionTheme" TargetType="Border" BasedOn="{StaticResource MarkdownAlertTheme}">
        <Setter Property="BorderBrush" Value="{DynamicResource MarkdownAlertCautionBorder}" />
        <Setter Property="Background" Value="{DynamicResource MarkdownAlertCautionBackground}" />
      </ControlTheme>
      <!-- The title, in the kind's colour. A foldable alert's title ([!KIND]- / [!KIND]+) toggles the
           body; the alert has :expanded while it is shown, and the title :expanded or :collapsed. In high contrast, every title is in the text
           colour, as all alerts share one border colour. -->
      <ControlTheme x:Key="MarkdownAlertHeaderTheme" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="{DynamicResource MarkdownAlertHeaderFontWeight}" />
        <Setter Property="FontSize" Value="{DynamicResource MarkdownAlertHeaderFontSize}" />
        <Setter Property="Margin" Value="{DynamicResource MarkdownAlertHeaderMargin}" />
        <!-- A foldable alert's title has :expanded or :collapsed, as the alert. A background makes the
             whole header row clickable, not just its glyphs. -->
        <Style Selector="^:expanded, ^:collapsed">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="^:collapsed">
          <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="^:focus-visible">
          <Setter Property="TextDecorations" Value="Underline" />
        </Style>
        <Style Selector="^[(mv|MarkdownViewer.InHighContrast)=True]">
          <Setter Property="Foreground" Value="{DynamicResource MarkdownHighContrastForeground}" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="MarkdownAlertNoteHeaderTheme" TargetType="TextBlock" BasedOn="{StaticResource MarkdownAlertHeaderTheme}">
        <Setter Property="Foreground" Value="{DynamicResource MarkdownAlertNoteBorder}" />
        <Style Selector="^[(mv|MarkdownViewer.InHighContrast)=True]">
          <Setter Property="Foreground" Value="{DynamicResource MarkdownHighContrastForeground}" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="MarkdownAlertTipHeaderTheme" TargetType="TextBlock" BasedOn="{StaticResource MarkdownAlertHeaderTheme}">
        <Setter Property="Foreground" Value="{DynamicResource MarkdownAlertTipBorder}" />
        <Style Selector="^[(mv|MarkdownViewer.InHighContrast)=True]">
          <Setter Property="Foreground" Value="{DynamicResource MarkdownHighContrastForeground}" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="MarkdownAlertImportantHeaderTheme" TargetType="TextBlock" BasedOn="{StaticResource MarkdownAlertHeaderTheme}">
        <Setter Property="Foreground" Value="{DynamicResource MarkdownAlertImportantBorder}" />
        <Style Selector="^[(mv|MarkdownViewer.InHighContrast)=True]">
          <Setter Property="Foreground" Value="{DynamicResource MarkdownHighContrastForeground}" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="MarkdownAlertWarningHeaderTheme" TargetType="TextBlock" BasedOn="{StaticResource MarkdownAlertHeaderTheme}">
        <Setter Property="Foreground" Value="{DynamicResource MarkdownAlertWarningBorder}" />
        <Style Selector="^[(mv|MarkdownViewer.InHighContrast)=True]">
          <Setter Property="Foreground" Value="{DynamicResource MarkdownHighContrastForeground}" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="MarkdownAlertCautionHeaderTheme" TargetType="TextBlock" BasedOn="{StaticResource MarkdownAlertHeaderTheme}">
        <Setter Property="Foreground" Value="{DynamicResource MarkdownAlertCautionBorder}" />
        <Style Selector="^[(mv|MarkdownViewer.InHighContrast)=True]">
          <Setter Property="Foreground" Value="{DynamicResource MarkdownHighContrastForeground}" />
        </Style>
      </ControlTheme>

      <!-- HTML <details> / <summary>: the summary toggles the body; :expanded while it is shown -->
      <ControlTheme x:Key="MarkdownDetailsTheme" TargetType="Border">
        <Setter Property="Margin" Value="{DynamicResource MarkdownDetailsMargin}" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownDetailsSummaryTheme" TargetType="TextBlock">
        <!-- A background makes the whole summary row clickable, not just its glyphs -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Style Selector="^:focus-visible">
          <Setter Property="TextDecorations" Value="Underline" />
        </Style>
      </ControlTheme>

      <!-- Thinking blocks (UseThinkingBlocks): a language model's reasoning, folded under a header; the border
           has :expanded while the reasoning is shown, and :thinking while a streaming session is still
           receiving it. The reasoning is dimmed, and still 4.5:1 or more on the page. -->
      <ControlTheme x:Key="MarkdownThinkingTheme" TargetType="Border">
        <Setter Property="Margin" Value="0,4" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownThinkingHeaderTheme" TargetType="TextBlock">
        <!-- A background makes the whole header row clickable, not just its glyphs -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Opacity" Value="{DynamicResource MarkdownThinkingHeaderOpacity}" />
        <Style Selector="^:focus-visible">
          <Setter Property="TextDecorations" Value="Underline" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="MarkdownThinkingContentTheme" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource MarkdownThinkingBorder}" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="Padding" Value="12,0,0,0" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Opacity" Value="{DynamicResource MarkdownThinkingContentOpacity}" />
      </ControlTheme>

      <!-- Figures -->
      <ControlTheme x:Key="MarkdownFigureTheme" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource MarkdownFigureBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,8" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownFigureCaptionTheme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Opacity" Value="{DynamicResource MarkdownFigureCaptionOpacity}" />
        <Setter Property="Margin" Value="0,4,0,0" />
      </ControlTheme>

      <!-- Definition lists -->
      <ControlTheme x:Key="MarkdownDefinitionTermTheme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,4,0,0" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownDefinitionTheme" TargetType="StackPanel">
        <Setter Property="Margin" Value="{DynamicResource MarkdownDefinitionMargin}" />
      </ControlTheme>

      <!-- Custom containers (:::name) -->
      <ControlTheme x:Key="MarkdownCustomContainerTheme" TargetType="Border">
        <Setter Property="BorderBrush" Value="#40808080" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource MarkdownCustomContainerCornerRadius}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="{DynamicResource MarkdownCustomContainerMargin}" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownCustomContainerTitleTheme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
      </ControlTheme>

      <!-- Footers (^^) -->
      <ControlTheme x:Key="MarkdownFooterTheme" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Opacity" Value="0.75" />
        <Setter Property="TextElement.FontSize" Value="12" />
      </ControlTheme>

      <!-- YouTube thumbnail embeds: a play symbol over a dark frame until the thumbnail loads -->
      <ControlTheme x:Key="MarkdownYoutubeOverlayTheme" TargetType="Grid">
        <Setter Property="Background" Value="#FF1A1A1A" />
      </ControlTheme>
      <ControlTheme x:Key="MarkdownYoutubePlayTheme" TargetType="TextBlock">
        <Setter Property="FontSize" Value="64" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Opacity" Value="0.85" />
      </ControlTheme>

      <!-- Code block copy button icons (16x16) -->
      <StreamGeometry x:Key="MarkdownCodeCopyIcon">M5,1 L15,1 L15,11 L12,11 L12,10 L14,10 L14,2 L6,2 L6,4 L5,4 Z M1,5 L11,5 L11,15 L1,15 Z M2,6 L2,14 L10,14 L10,6 Z</StreamGeometry>
      <StreamGeometry x:Key="MarkdownCodeCopiedIcon">M13.5,3.5 L6,11 L2.5,7.5 L1.5,8.5 L6,13 L14.5,4.5 Z</StreamGeometry>
      <!-- Labels of the viewer's context menu; Copy uses StringTextFlyoutCopyText, as a TextBox does -->
      <x:String x:Key="MarkdownStringCopyAsMarkdown">Copy as Markdown</x:String>
      <x:String x:Key="MarkdownStringCopyLink">Copy link</x:String>
      <x:String x:Key="MarkdownStringCopyHeadingLink">Copy link to heading</x:String>
      <x:String x:Key="MarkdownStringCopyTable">Copy table</x:String>
      <x:String x:Key="MarkdownStringCopyTableAsMarkdown">Copy table as Markdown</x:String>
      <x:String x:Key="MarkdownStringSaveImage">Save image as…</x:String>
      <x:String x:Key="MarkdownStringSelectAll">Select all</x:String>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Styles: only for the viewer itself and for types a document has few of (buttons, images,
       separators, links, the fold toggle), since a style costs memory on every control of its type.
       Everything else is styled by the control themes above. -->

  <!-- Use :is() so subclasses of MarkdownViewer also get the default template (and thus PART_ScrollViewer) -->
  <Style Selector=":is(mv|MarkdownViewer)">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ScrollViewer Name="PART_ScrollViewer"
                        Background="{TemplateBinding Background}"
                        AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}"
                        BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}"
                        HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                        VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                        IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                        IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}"
                        VerticalSnapPointsType="{TemplateBinding (ScrollViewer.VerticalSnapPointsType)}"
                        HorizontalSnapPointsType="{TemplateBinding (ScrollViewer.HorizontalSnapPointsType)}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Margin="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- Foldable headings (MarkdownViewer.AreHeadingsFoldable): the fold button before the heading's text;
       the heading gets :expanded while its section is shown -->
  <Style Selector="mrb|HeadingFoldToggle.markdown-heading-fold">
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="Opacity" Value="{DynamicResource MarkdownHeadingFoldOpacity}" />
  </Style>
  <Style Selector="mrb|HeadingFoldToggle.markdown-heading-fold:pointerover, mrb|HeadingFoldToggle.markdown-heading-fold:focus-visible">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Copy button of code blocks, in their toolbar -->
  <Style Selector="Button.markdown-code-copy">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource MarkdownCodeHeaderForeground}" />
    <Setter Property="ToolTip.Tip" Value="Copy code" />
    <Setter Property="AutomationProperties.Name" Value="Copy code" />
  </Style>
  <Style Selector="Button.markdown-code-copy:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MarkdownCodeCopyButtonHoverBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource MarkdownCodeBlockForeground}" />
  </Style>
  <Style Selector="Button.markdown-code-copy.copied">
    <Setter Property="ToolTip.Tip" Value="Copied" />
  </Style>
  <Style Selector="Button.markdown-code-copy PathIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Data" Value="{StaticResource MarkdownCodeCopyIcon}" />
  </Style>
  <Style Selector="Button.markdown-code-copy.copied PathIcon">
    <Setter Property="Data" Value="{StaticResource MarkdownCodeCopiedIcon}" />
  </Style>

  <!-- Copy button of display formulas (MarkView.Avalonia.Math): a markdown-code-copy in the top
       right corner of the formula -->
  <Style Selector="Button.markdown-code-copy.markdown-math-copy">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <!-- Lined up with the copy button of a code block, inside its toolbar's padding -->
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="ToolTip.Tip" Value="Copy formula" />
    <Setter Property="AutomationProperties.Name" Value="Copy formula" />
  </Style>
  <Style Selector="Button.markdown-code-copy.markdown-math-copy.copied">
    <Setter Property="ToolTip.Tip" Value="Copied" />
  </Style>

  <!-- MarkdownViewer.ShowCodeBlockCopyButtonOnHover: copy buttons are transparent, but keep their
       place and Tab stop, until the pointer is over their block, they have keyboard focus, or they
       confirm a copy -->
  <Style Selector=":is(mv|MarkdownViewer):copy-on-hover Button.markdown-code-copy">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector=":is(mv|MarkdownViewer):copy-on-hover StackPanel.markdown-code-container:pointerover Button.markdown-code-copy,
                   :is(mv|MarkdownViewer):copy-on-hover Grid.markdown-math-container:pointerover Button.markdown-code-copy,
                   :is(mv|MarkdownViewer):copy-on-hover Button.markdown-code-copy:focus-visible,
                   :is(mv|MarkdownViewer):copy-on-hover Button.markdown-code-copy.copied">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Thematic break -->
  <Style Selector="Separator.markdown-thematic-break">
    <Setter Property="Margin" Value="0,8" />
  </Style>

  <!-- Images. What a zoomable image does, and what the lightbox is called without alt text, for
       screen readers, are set here so they can be translated. -->
  <Style Selector="Image.markdown-image">
    <Setter Property="Margin" Value="0,4" />
  </Style>
  <Style Selector="Image.markdown-image-zoomable">
    <Setter Property="AutomationProperties.HelpText" Value="Zoom" />
  </Style>
  <!-- Lightbox a clicked image opens in (MarkdownViewer.IsImageZoomEnabled) -->
  <Style Selector="mr|ImageLightbox">
    <Setter Property="AutomationProperties.Name" Value="Image" />
    <Setter Property="Background" Value="{DynamicResource MarkdownImageLightboxBackdrop}" />
  </Style>
  <Style Selector="Image.markdown-image-lightbox-image">
    <Setter Property="Margin" Value="48" />
  </Style>
  <Style Selector="Button.markdown-image-lightbox-close">
    <Setter Property="Background" Value="{DynamicResource MarkdownImageLightboxCloseBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource MarkdownImageLightboxCloseForeground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Margin" Value="8" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="ToolTip.Tip" Value="Close" />
    <Setter Property="AutomationProperties.Name" Value="Close" />
  </Style>
  <Style Selector="Button.markdown-image-lightbox-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MarkdownImageLightboxCloseHoverBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource MarkdownImageLightboxCloseForeground}" />
  </Style>
  <Style Selector="Button.markdown-image-lightbox-zoom">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MarkdownImageLightboxCloseForeground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="FontSize" Value="16" />
  </Style>
  <Style Selector="Button.markdown-image-lightbox-zoom:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MarkdownImageLightboxCloseHoverBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource MarkdownImageLightboxCloseForeground}" />
  </Style>
  <Style Selector="Button.markdown-image-lightbox-zoom-out">
    <Setter Property="ToolTip.Tip" Value="Zoom out" />
    <Setter Property="AutomationProperties.Name" Value="Zoom out" />
  </Style>
  <Style Selector="Button.markdown-image-lightbox-zoom-in">
    <Setter Property="ToolTip.Tip" Value="Zoom in" />
    <Setter Property="AutomationProperties.Name" Value="Zoom in" />
  </Style>
  <Style Selector="Button.markdown-image-lightbox-zoom-fit">
    <Setter Property="ToolTip.Tip" Value="Fit to view" />
    <Setter Property="AutomationProperties.Name" Value="Fit to view" />
  </Style>
  <!-- Save button (MarkdownViewer.IsImageSaveEnabled), after the zoom buttons, in their style -->
  <Style Selector="Button.markdown-image-lightbox-save">
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="ToolTip.Tip" Value="Save as…" />
    <Setter Property="AutomationProperties.Name" Value="Save as" />
  </Style>

  <!-- Text selection highlight -->
  <Style Selector=":is(SelectableTextBlock)">
    <Setter Property="SelectionBrush" Value="{DynamicResource SystemAccentColor}"/>
  </Style>

  <!-- Links -->
  <Style Selector="mri|MarkdownHyperlink.markdown-link">
    <Setter Property="Foreground" Value="{DynamicResource MarkdownLinkForeground}"/>
    <Setter Property="TextDecorations" Value="Underline"/>
  </Style>

  <!-- Footnote references -->
  <Style Selector="mri|MarkdownHyperlink.markdown-footnote-ref">
    <Setter Property="Foreground" Value="{DynamicResource MarkdownLinkForeground}" />
    <Setter Property="TextDecorations" Value="Underline" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="BaselineAlignment" Value="Superscript" />
  </Style>

  <!-- YouTube thumbnail embeds -->
  <Style Selector="Button.markdown-youtube">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,4" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <!-- Explicit dimensions ensure the button has a visible area before the thumbnail loads -->
  <Style Selector="Image.markdown-youtube-thumbnail">
    <Setter Property="Width" Value="480" />
    <Setter Property="Height" Value="270" />
    <Setter Property="Stretch" Value="UniformToFill" />
  </Style>

  <!-- High contrast: most of it is MarkdownHighContrastPalette above, and the control themes' own
       styles for MarkdownViewer.InHighContrast. These set what no key expresses on the viewer itself and on separators.
       They come last so they win over the ones above. -->
  <Style Selector=":is(mv|MarkdownViewer):high-contrast">
    <Setter Property="Background" Value="{DynamicResource MarkdownHighContrastBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource MarkdownHighContrastForeground}" />
  </Style>
  <Style Selector=":is(mv|MarkdownViewer):high-contrast Separator.markdown-thematic-break">
    <Setter Property="Background" Value="{DynamicResource MarkdownHighContrastBorder}" />
  </Style>

</Styles>
