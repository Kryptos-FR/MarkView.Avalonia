<!-- GitHub preset: makes the document look like Markdown rendered on github.com, with GitHub's
     Primer colours in both variants. Include it after MarkdownTheme.axaml, which it builds on:
     it redefines the resources where GitHub's look differs (colours, sizes, and the control themes
     of a few roles), and styles only the viewer, buttons, separators and links. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mv="using:MarkView.Avalonia"
        xmlns:mr="using:MarkView.Avalonia.Rendering"
        xmlns:mri="using:MarkView.Avalonia.Rendering.Inlines">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <!-- Primer "dark default". Translucent Primer colours are written #AARRGGBB, Avalonia's order. -->
        <ResourceDictionary x:Key="Dark">
          <!-- The document's own background and text, set on MarkdownViewer -->
          <SolidColorBrush x:Key="MarkdownBackground">#0D1117</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownForeground">#F0F6FC</SolidColorBrush>
          <!-- Secondary text: blockquotes, h6, footnotes, task check boxes -->
          <SolidColorBrush x:Key="MarkdownMutedForeground">#9198A1</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownLinkForeground">#4493F8</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHeadingBorder">#B33D444D</SolidColorBrush>
          <!-- GitHub draws the blockquote bar, table grid and rule in #3D444D, which is below the 3:1
               WCAG AA minimum for borders that carry meaning; Primer's emphasis border colour meets it. -->
          <SolidColorBrush x:Key="MarkdownBlockquoteBorder">#656C76</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownTableBorder">#656C76</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownTableRowAlternateBackground">#151B23</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownThematicBreakBackground">#656C76</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownFootnoteSeparatorBackground">#3D444D</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeBlockBackground">#151B23</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeBlockForeground">#F0F6FC</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeInlineBackground">#33656C76</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeInlineForeground">#F0F6FC</SolidColorBrush>
          <!-- The toolbar shares the code's background, so the copy button sits in the block's corner -->
          <SolidColorBrush x:Key="MarkdownCodeHeaderBackground">#151B23</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeHeaderForeground">#9198A1</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeCopyButtonBorder">#3D444D</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeCopyButtonHoverBackground">#33656C76</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeLineNumberForeground">#9198A1</SolidColorBrush>
          <!-- Alerts: GitHub's bar and title colours, and no background -->
          <SolidColorBrush x:Key="MarkdownAlertDefaultBorder">#9198A1</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertDefaultBackground">#00000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertNoteBorder">#4493F8</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertNoteBackground">#00000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertTipBorder">#3FB950</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertTipBackground">#00000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertImportantBorder">#AB7DF8</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertImportantBackground">#00000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertWarningBorder">#D29922</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertWarningBackground">#00000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertCautionBorder">#F85149</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertCautionBackground">#00000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownMarkedBackground">#26BB8009</SolidColorBrush>
          <!-- HTML <kbd>: GitHub's key, with a border that stays 3:1 on the page and the key -->
          <SolidColorBrush x:Key="MarkdownKbdBackground">#151B23</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownKbdForeground">#F0F6FC</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownKbdBorder">#656C76</SolidColorBrush>
          <!-- Find matches: Primer yellow and orange, distinct from highlighted (==…==) text -->
          <SolidColorBrush x:Key="MarkdownFindMatchBackground">#693E00</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownFindCurrentMatchBackground">#762D0A</SolidColorBrush>
          <!-- Image that could not be loaded: secondary text on the code background -->
          <SolidColorBrush x:Key="MarkdownImageFailedForeground">#9198A1</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageFailedBackground">#151B23</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageFailedBorder">#656C76</SolidColorBrush>
          <!-- Image lightbox, as in the default theme -->
          <SolidColorBrush x:Key="MarkdownImageLightboxBackdrop">#E0000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageLightboxCloseForeground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageLightboxCloseBackground">#66000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageLightboxCloseHoverBackground">#33FFFFFF</SolidColorBrush>
          <!-- High-contrast palette (MarkdownViewer:high-contrast): Primer "dark high contrast". Every
               pair is 7:1 or more: text 17.6:1, links 9.2:1, borders 10.4:1, highlighted text 10.7:1. -->
          <SolidColorBrush x:Key="MarkdownHighContrastBackground">#0A0C10</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastForeground">#F0F3F6</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastLink">#71B7FF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastHighlightBackground">#F0B72F</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastHighlightForeground">#0A0C10</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastBorder">#B7BDC8</SolidColorBrush>
        </ResourceDictionary>
        <!-- Primer "light default" -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="MarkdownBackground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownForeground">#1F2328</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownMutedForeground">#59636E</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownLinkForeground">#0969DA</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHeadingBorder">#B3D1D9E0</SolidColorBrush>
          <!-- GitHub's #D1D9E0 is below 3:1 on white; see the Dark dictionary -->
          <SolidColorBrush x:Key="MarkdownBlockquoteBorder">#818B98</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownTableBorder">#818B98</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownTableRowAlternateBackground">#F6F8FA</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownThematicBreakBackground">#818B98</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownFootnoteSeparatorBackground">#D1D9E0</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeBlockBackground">#F6F8FA</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeBlockForeground">#1F2328</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeInlineBackground">#1F818B98</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeInlineForeground">#1F2328</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeHeaderBackground">#F6F8FA</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeHeaderForeground">#59636E</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeCopyButtonBorder">#D1D9E0</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeCopyButtonHoverBackground">#1A818B98</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownCodeLineNumberForeground">#59636E</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertDefaultBorder">#59636E</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertDefaultBackground">#00000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertNoteBorder">#0969DA</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertNoteBackground">#00000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertTipBorder">#1A7F37</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertTipBackground">#00000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertImportantBorder">#8250DF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertImportantBackground">#00000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertWarningBorder">#9A6700</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertWarningBackground">#00000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertCautionBorder">#D1242F</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownAlertCautionBackground">#00000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownMarkedBackground">#FFF8C5</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownKbdBackground">#F6F8FA</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownKbdForeground">#1F2328</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownKbdBorder">#818B98</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownFindMatchBackground">#FAE17D</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownFindCurrentMatchBackground">#FFB77C</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageFailedForeground">#59636E</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageFailedBackground">#F6F8FA</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageFailedBorder">#818B98</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageLightboxBackdrop">#CC000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageLightboxCloseForeground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageLightboxCloseBackground">#66000000</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownImageLightboxCloseHoverBackground">#33FFFFFF</SolidColorBrush>
          <!-- Primer "light high contrast": text 18.9:1, links 8.0:1, borders 15.4:1, highlighted text 8.1:1 -->
          <SolidColorBrush x:Key="MarkdownHighContrastBackground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastForeground">#0E1116</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastLink">#0349B4</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastHighlightBackground">#744500</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastHighlightForeground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="MarkdownHighContrastBorder">#20252C</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Sizes and spacing (see MarkdownTheme.axaml) -->
      <FontFamily x:Key="MarkdownCodeFontFamily">SF Mono, Menlo, Consolas, Liberation Mono, Courier New, monospace</FontFamily>
      <!-- Code blocks: 16px padding, 6px corners, 85% monospace text -->
      <x:Double x:Key="MarkdownCodeFontSize">13.6</x:Double>
      <x:Double x:Key="MarkdownCodeLineHeight">20</x:Double>
      <CornerRadius x:Key="MarkdownCodeBlockCornerRadius">6</CornerRadius>
      <Thickness x:Key="MarkdownCodeBlockPadding">16</Thickness>
      <CornerRadius x:Key="MarkdownToolbarCodeBlockCornerRadius">0,0,6,6</CornerRadius>
      <Thickness x:Key="MarkdownToolbarCodeBlockPadding">16,0,16,16</Thickness>
      <CornerRadius x:Key="MarkdownCodeHeaderCornerRadius">6,6,0,0</CornerRadius>
      <Thickness x:Key="MarkdownCodeHeaderPadding">16,6,6,0</Thickness>
      <!-- The copy button is wider here; keep the formula clear of it -->
      <Thickness x:Key="MarkdownMathContentMargin">38,0</Thickness>
      <!-- Paragraphs: 16px apart; tight inside list items, table cells, quotes and alerts -->
      <Thickness x:Key="MarkdownParagraphMargin">0,4</Thickness>
      <x:Double x:Key="MarkdownParagraphLineSpacing">4</x:Double>
      <Thickness x:Key="MarkdownListParagraphMargin">0</Thickness>
      <Thickness x:Key="MarkdownTableParagraphMargin">0</Thickness>
      <x:Double x:Key="MarkdownTableParagraphLineSpacing">4</x:Double>
      <Thickness x:Key="MarkdownQuoteParagraphMargin">0</Thickness>
      <Thickness x:Key="MarkdownAlertParagraphMargin">0</Thickness>
      <x:Double x:Key="MarkdownAlertParagraphLineSpacing">4</x:Double>
      <!-- Lists: text 2em from the left edge, nested lists without extra space -->
      <Thickness x:Key="MarkdownListMargin">18,4,0,4</Thickness>
      <Thickness x:Key="MarkdownNestedListMargin">18,0,0,0</Thickness>
      <!-- Tables: a 1px grid on every side of every cell, a semibold header without background, centred
           as browsers draw <th>, and striped body rows -->
      <Thickness x:Key="MarkdownTableCellPadding">13,6</Thickness>
      <Thickness x:Key="MarkdownTableFirstRowCellBorderThickness">0,1,1,1</Thickness>
      <Thickness x:Key="MarkdownTableFirstColumnCellBorderThickness">1,0,1,1</Thickness>
      <Thickness x:Key="MarkdownTableCornerCellBorderThickness">1</Thickness>
      <SolidColorBrush x:Key="MarkdownTableHeaderBackground">Transparent</SolidColorBrush>
      <FontWeight x:Key="MarkdownTableHeaderFontWeight">SemiBold</FontWeight>
      <HorizontalAlignment x:Key="MarkdownTableHeaderAlignment">Center</HorizontalAlignment>
      <!-- Alerts: a 4px bar without background, the title in the bar's colour at body size -->
      <CornerRadius x:Key="MarkdownAlertCornerRadius">0</CornerRadius>
      <Thickness x:Key="MarkdownAlertPadding">16,8</Thickness>
      <FontWeight x:Key="MarkdownAlertHeaderFontWeight">Medium</FontWeight>
      <x:Double x:Key="MarkdownAlertHeaderFontSize">16</x:Double>
      <!-- Definition lists: definitions indented by 16px -->
      <Thickness x:Key="MarkdownDefinitionMargin">16,0,0,0</Thickness>

      <!-- Headings: 2em / 1.5em / 1.25em / 1em / 0.875em / 0.85em, semibold, 24px above and 16px below
           (the document's 8px block spacing plus these margins), and no space above a heading that starts
           the document, a quote or an alert. A rule under h1 and h2, 0.3em below the text. -->
      <ControlTheme x:Key="MarkdownHeading1Theme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,16,0,8" />
        <Setter Property="Padding" Value="0,0,0,10" />
        <Setter Property="BorderBrush" Value="{DynamicResource MarkdownHeadingBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Style Selector="^:nth-child(1)">
          <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="MarkdownHeading2Theme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,16,0,8" />
        <Setter Property="Padding" Value="0,0,0,7" />
        <Setter Property="BorderBrush" Value="{DynamicResource MarkdownHeadingBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Style Selector="^:nth-child(1)">
          <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="MarkdownHeading3Theme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,16,0,8" />
        <Style Selector="^:nth-child(1)">
          <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="MarkdownHeading4Theme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,16,0,8" />
        <Style Selector="^:nth-child(1)">
          <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="MarkdownHeading5Theme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,16,0,8" />
        <Style Selector="^:nth-child(1)">
          <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="MarkdownHeading6Theme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="FontSize" Value="13.6" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,16,0,8" />
        <Setter Property="Foreground" Value="{DynamicResource MarkdownMutedForeground}" />
        <Style Selector="^:nth-child(1)">
          <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
      </ControlTheme>

      <!-- Inline code: monospace at 85% of the paragraph's size (but full size in a heading) -->
      <ControlTheme x:Key="MarkdownParagraphCodeInlineTheme" TargetType="Run">
        <Setter Property="FontFamily" Value="{DynamicResource MarkdownCodeFontFamily}" />
        <Setter Property="FontSize" Value="13.6" />
        <Setter Property="Background" Value="{DynamicResource MarkdownCodeInlineBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource MarkdownCodeInlineForeground}" />
      </ControlTheme>

      <!-- Blockquote: a 4px bar and secondary text, no dimming -->
      <ControlTheme x:Key="MarkdownBlockquoteTheme" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource MarkdownBlockquoteBorder}" />
        <Setter Property="BorderThickness" Value="4,0,0,0" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MarkdownMutedForeground}" />
      </ControlTheme>

      <!-- Task-list check boxes look read-only, like GitHub's -->
      <ControlTheme x:Key="MarkdownTaskMarkerTheme" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Symbol, Noto Sans Symbols, DejaVu Sans, sans-serif" />
        <Setter Property="Foreground" Value="{DynamicResource MarkdownMutedForeground}" />
      </ControlTheme>

      <!-- Footnotes: in 12px secondary text, no dimming -->
      <ControlTheme x:Key="MarkdownFootnoteGroupTheme" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MarkdownMutedForeground}" />
        <Setter Property="TextElement.FontSize" Value="12" />
      </ControlTheme>

      <!-- Definition lists: italic semibold terms -->
      <ControlTheme x:Key="MarkdownDefinitionTermTheme" TargetType="mr:MarkdownSelectableTextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Margin" Value="0,8,0,0" />
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Document: GitHub's background, text colour and system font stack at 16px. Local values set on
       a MarkdownViewer (Background="Transparent", FontSize="14") still win. The stack ends with the
       Inter an application embeds (WithInterFont), which stands in for CSS's sans-serif where none of
       the system fonts exist, as in the browser (Avalonia would otherwise take SkiaSharp's own font). -->
  <Style Selector=":is(mv|MarkdownViewer)">
    <Setter Property="Background" Value="{DynamicResource MarkdownBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource MarkdownForeground}" />
    <Setter Property="FontFamily" Value="Segoe UI, SF Pro Text, Helvetica Neue, Noto Sans, Helvetica, Arial, fonts:Inter#Inter" />
    <Setter Property="FontSize" Value="16" />
  </Style>

  <!-- Copy buttons: outlined, in the block's corner, the formula's lined up with a code block's -->
  <Style Selector="Button.markdown-code-copy">
    <Setter Property="BorderBrush" Value="{DynamicResource MarkdownCodeCopyButtonBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="7" />
  </Style>
  <Style Selector="Button.markdown-code-copy:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource MarkdownCodeCopyButtonBorder}" />
  </Style>
  <Style Selector="Button.markdown-code-copy.markdown-math-copy">
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>

  <!-- Horizontal rule: a 4px bar with 24px above and below -->
  <Style Selector="Separator.markdown-thematic-break">
    <Setter Property="Background" Value="{DynamicResource MarkdownThematicBreakBackground}" />
    <Setter Property="Height" Value="4" />
    <Setter Property="Margin" Value="0,16" />
  </Style>

  <!-- Footnotes: below a 1px line; references at the footnotes' size -->
  <Style Selector="Separator.markdown-footnote-separator">
    <Setter Property="Background" Value="{DynamicResource MarkdownFootnoteSeparatorBackground}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,24,0,0" />
  </Style>
  <Style Selector="mri|MarkdownHyperlink.markdown-footnote-ref">
    <Setter Property="FontSize" Value="12" />
  </Style>
</Styles>
