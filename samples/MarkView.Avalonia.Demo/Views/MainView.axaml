<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mv="using:MarkView.Avalonia"
             xmlns:local="using:MarkView.Avalonia.Demo"
             xmlns:ce="using:MarkView.Avalonia.Demo.ColorExtension"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="MarkView.Avalonia.Demo.Views.MainView"
             x:DataType="local:MainViewModel">

  <UserControl.Resources>
    <local:OutlineFilterConverter x:Key="OutlineFilterConverter" />
  </UserControl.Resources>

  <DockPanel>
    <!-- Page tabs -->
    <TabControl DockPanel.Dock="Top" SelectedIndex="{Binding SelectedIndex}">
      <TabItem Header="Feature Showcase" />
      <TabItem Header="Extensions Showcase" />
      <TabItem Header="Custom Styling" />
      <TabItem Header="Color Extension" />
      <TabItem Header="README" />
    </TabControl>

    <!-- Top bar -->
    <Border DockPanel.Dock="Top" Padding="12,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <!-- Outline -->
        <ToggleButton x:Name="OutlineToggle"
                      Width="32" Height="32" Padding="4">
          <PathIcon Data="{StaticResource text_bullet_list_tree_regular}" />
        </ToggleButton>
        <Popup x:Name="OutlinePopup"
               IsOpen="{Binding #OutlineToggle.IsChecked, Mode=TwoWay}" IsLightDismissEnabled="True"
               PlacementTarget="{Binding #OutlineToggle}">
          <Border Background="{DynamicResource MenuFlyoutPresenterBackground}"
                  BorderBrush="{DynamicResource MenuFlyoutPresenterBorderBrush}"
                  BorderThickness="{DynamicResource MenuFlyoutPresenterBorderThemeThickness}"
                  CornerRadius="{DynamicResource OverlayCornerRadius}"
                  Padding="8" MinWidth="260" MaxWidth="360" MaxHeight="420">
            <DockPanel>
              <TextBox x:Name="OutlineFilterBox" DockPanel.Dock="Top"
                       PlaceholderText="Filter headings" Margin="0,0,0,8" />
              <ScrollViewer>
                <ListBox x:Name="OutlineList"
                         Background="Transparent"
                         SelectionChanged="OnOutlineSelectionChanged">
                  <ListBox.ItemsSource>
                    <MultiBinding Converter="{StaticResource OutlineFilterConverter}">
                      <Binding ElementName="MarkdownView" Path="TableOfContents" />
                      <Binding ElementName="OutlineFilterBox" Path="Text" />
                    </MultiBinding>
                  </ListBox.ItemsSource>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="local:OutlineRow">
                      <TextBlock Text="{Binding Entry.Text}" Margin="{Binding Indent}"
                                 TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Popup>
        <Button Content="←"
                Click="OnGoBackClicked"
                IsEnabled="{Binding CanGoBack}"
                ToolTip.Tip="Go back"
                VerticalAlignment="Center" />
        <Button Content="→"
                Click="OnGoForwardClicked"
                IsEnabled="{Binding CanGoForward}"
                ToolTip.Tip="Go forward"
                VerticalAlignment="Center" />
        <Button Content="Open file…"
                Click="OnOpenFileClicked"
                VerticalAlignment="Center" />
        <ToggleButton IsChecked="{Binding IsLightTheme}"
                      Content="Light theme"
                      VerticalAlignment="Center" />
        <ComboBox SelectedIndex="{Binding ThemePresetIndex}"
                  ToolTip.Tip="Theme preset"
                  AutomationProperties.Name="Theme preset"
                  VerticalAlignment="Center">
          <ComboBoxItem Content="Default theme" />
          <ComboBoxItem Content="GitHub theme" />
        </ComboBox>
        <ToggleButton IsChecked="{Binding #MarkdownView.AreTaskListsInteractive}"
                      Content="Clickable tasks"
                      ToolTip.Tip="Render task-list items as checkboxes you can toggle"
                      VerticalAlignment="Center" />
        <ToggleButton IsChecked="{Binding #MarkdownView.ShowCodeBlockLineNumbers}"
                      Content="Line numbers"
                      ToolTip.Tip="Number the lines of code blocks"
                      VerticalAlignment="Center" />
        <ToggleButton IsChecked="{Binding #MarkdownView.WrapCodeBlockLines}"
                      Content="Wrap code"
                      ToolTip.Tip="Wrap code lines longer than their block"
                      VerticalAlignment="Center" />
        <ToggleButton IsChecked="{Binding IsCodeHeightLimited}"
                      Content="Short code blocks"
                      ToolTip.Tip="Cap code blocks at 160 pixels; taller blocks scroll inside themselves"
                      VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Page content -->
    <Grid>
      <mv:MarkdownViewer x:Name="MarkdownView"
                         Source="{Binding Source}" Markdown="{Binding Markdown}"
                         Classes.custom-styled="{Binding IsCustomStyled}"
                         CodeBlockMaxHeight="{Binding CodeBlockMaxHeight}"
                         IsVisible="{Binding !IsColorExtensionSelected}"
                         Padding="4" />
      <ce:ColorExtensionView IsVisible="{Binding IsColorExtensionSelected}" />
    </Grid>
  </DockPanel>

</UserControl>
